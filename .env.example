# Copy to .env (Docker Compose, Bun). Everything is optional; without OBX_SECRET_KEY a key is generated
# into the data volume on first start (back it up with the database).
# Public address of the portal (used in e-mails and links). Docker Compose default: http://localhost:<OBX_PORT>.
# OBX_PUBLIC_URL=https://brands.yourbrand.com
# A long random string: openssl rand -base64 48 (keep it; it encrypts stored credentials).
OBX_SECRET_KEY=
# A code you choose for the setup wizard (otherwise one is printed in the log on first start).
OBX_SETUP_CODE=
# E-mail (invitations, password resets, "your download is ready"): resend | postmark | sendgrid | mailchannels | webhook
OBX_MAIL_PROVIDER=
OBX_MAIL_API_KEY=
OBX_MAIL_FROM=
# Storage for images: disk (default, under OBX_DATA_DIR) or s3 (AWS S3, MinIO, R2, Backblaze, Google Cloud Storage)
OBX_STORAGE=disk
OBX_S3_ENDPOINT=
OBX_S3_BUCKET=
OBX_S3_REGION=
OBX_S3_ACCESS_KEY_ID=
OBX_S3_SECRET_ACCESS_KEY=
# Only for local development: allow http:// and private addresses for imports and webhooks.
OBX_ALLOW_PRIVATE_URLS=false
# Behind a reverse proxy (Caddy, nginx, Cloud Run): trust X-Forwarded-For / X-Forwarded-Proto.
OBX_TRUST_PROXY=false

# Docker Compose: host port for the portal.
OBX_PORT=8080
# Docker Compose with a local S3 server: create the bucket on start.
OBX_S3_CREATE_BUCKET=false
