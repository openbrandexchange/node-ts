// The public demo portal of Open Brand Exchange (docs/demo.md): the normal Workers edition with
// OBX_DEMO=true, its own D1 database and R2 bucket (both EU jurisdiction), rate limiting bindings,
// and the UI served through the Worker so its pages carry the demo's headers.
//   bunx wrangler deploy -c deploy/demo/wrangler.jsonc
// Paths are relative to this file.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "obx-portal-demo",
  "main": "../../src/adapters/workers/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "obx-portal-demo-db",
      "database_id": "e7dc816c-c48f-414a-857f-fe2f87577167",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "obx-portal-demo-files",
      "jurisdiction": "eu"
    }
  ],
  // Every minute: background jobs and the demo's scheduled reset (OBX_DEMO_RESET_MINUTES).
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Abuse limits per client address and minute (namespace ids are unique per account).
  "ratelimits": [
    { "name": "DEMO_READ_LIMIT", "namespace_id": "51001", "simple": { "limit": 300, "period": 60 } },
    { "name": "DEMO_WRITE_LIMIT", "namespace_id": "51002", "simple": { "limit": 40, "period": 60 } },
    { "name": "DEMO_LOGIN_LIMIT", "namespace_id": "51003", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "OBX_DEMO": "true",
    "OBX_DEMO_RESET_MINUTES": "60",
    "OBX_ALLOW_PRIVATE_URLS": "false",
    // Turnstile on the sign-in buttons: the site key is public; OBX_DEMO_TURNSTILE_SECRET is a secret.
    "OBX_DEMO_TURNSTILE_SITE_KEY": "0x4AAAAAAF-kIqFzNuB_vKJU"
  },
  // Secrets (wrangler secret put … -c deploy/demo/wrangler.jsonc): OBX_SECRET_KEY, OBX_DEMO_TURNSTILE_SECRET.
  "observability": {
    "enabled": true
  }
}
