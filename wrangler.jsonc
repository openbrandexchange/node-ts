// Cloudflare Workers edition ("Portal for Cloudflare").
// `bun run deploy` (and the Deploy to Cloudflare button, which runs the same script) deploys the
// Worker, lets Wrangler create the D1 database and the R2 bucket below when they do not exist yet,
// and applies migrations/ to D1. The Worker also applies missing migrations itself at its first
// request, so a plain `wrangler deploy` works too. Secrets: OBX_SECRET_KEY (required) and
// OBX_SETUP_CODE (recommended); the button asks for both (.dev.vars.example). Plans and limits:
// docs/hosting-cloudflare.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brand-portal",
  "main": "src/adapters/workers/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // The admin UI (vendored admin-ui build) is served as static assets; API paths run the Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/admin/api/*", "/obx/*", "/.well-known/*", "/healthz", "/readyz", "/metrics"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brand-portal-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "brand-portal-files"
    }
  ],
  // Every minute: scheduled imports, background jobs (zips, exports, imports), webhooks, expiry.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "OBX_ALLOW_PRIVATE_URLS": "false"
  },
  "observability": {
    "enabled": true
  }
  // CPU time: every background step checkpoints within 20-25 s, inside the Workers Paid default of
  // 30 s, so no "limits" entry is needed (setting one is refused on the free plan).
  // Optional: a Queue lets long background jobs continue immediately instead of once a minute.
  // Uncomment, then `bunx wrangler queues create brand-portal-jobs`.
  // "queues": {
  //   "producers": [{ "binding": "JOBS", "queue": "brand-portal-jobs" }],
  //   "consumers": [{ "queue": "brand-portal-jobs", "max_batch_size": 1, "max_retries": 3 }]
  // }
}
