{
  "name": "obx-node-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Open Brand Exchange node in TypeScript (Hono) for Cloudflare Workers and Bun",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/adapters/bun/main.ts",
    "start": "bun src/adapters/bun/main.ts",
    "gen": "bun scripts/gen-migrations.ts",
    "test": "bun scripts/gen-migrations.ts && bun test --timeout 120000 ./test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:workers": "wrangler dev",
    "deploy": "wrangler deploy && wrangler d1 migrations apply DB --remote",
    "smoke:workers": "bun scripts/workers-smoke.ts",
    "update-ui": "sh scripts/update-ui.sh",
    "sync-fixtures": "sh scripts/sync-fixtures.sh",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "lint": "oxlint --deny-warnings src scripts test e2e",
    "licenses": "bun scripts/check-licenses.ts",
    "audit": "bun audit --audit-level=moderate",
    "loadtest": "bun scripts/loadtest.ts",
    "e2e": "sh e2e/run.sh",
    "release:build": "sh scripts/build-release.sh",
    "backup": "bun src/adapters/bun/backup.ts"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "bcryptjs": "^3.0.3",
    "hono": "^4.13.18"
  },
  "optionalDependencies": {
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxlint": "^1.86.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.160.1"
  },
  "cloudflare": {
    "label": "Open Brand Exchange · Portal for Cloudflare",
    "products": [
      "Workers",
      "D1",
      "R2"
    ],
    "categories": [
      "storage"
    ],
    "docs_url": "https://github.com/openbrandexchange/node-ts#readme",
    "bindings": {
      "OBX_SECRET_KEY": {
        "description": "A long random string (at least 32 characters). It encrypts stored credentials and signs download links. Generate one with: openssl rand -base64 48"
      },
      "OBX_SETUP_CODE": {
        "description": "A code you choose (6+ characters). You type it once in the setup wizard, so nobody else can claim your new node."
      }
    }
  }
}
